# FPL Value Studio — production (linux-leif). Copy to .env and fill in secrets.
#
# `docker-compose.yml` sets PORT and DATABASE_URL itself; do not set them here.

FPL_STUDIO_PORT=8788

POSTGRES_DB=fpl
POSTGRES_USER=fpl
POSTGRES_PASSWORD=

# local = no sign-in anywhere; the tailnet is the only access control. Permitted
# with PostgreSQL only because TRUSTED_NETWORK asserts what makes it safe: Caddy
# binds the Tailscale address, so this host is not publicly reachable. Set both
# back to `private` / `false` together if that ever stops being true.
# See docs/SECURITY.md for the full matrix.
ACCESS_MODE=local
TRUSTED_NETWORK=true

# SESSION_SECRET still signs the session cookie that carries the CSRF token, so
# it is required even with no sign-in.
SESSION_SECRET=

# Inert while ACCESS_MODE=local. Kept, not deleted: switching back to `private`
# with no credentials configured locks everyone out, because valid_credentials
# denies rather than grants when they are absent.
APP_USERNAME=
APP_PASSWORD=
SESSION_MAX_AGE_SECONDS=43200
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900
CSRF_ENABLED=true

FPL_ENTRY_ID=
CURRENT_SEASON=2026/27
APP_TIMEZONE=America/New_York
REFRESH_HOUR=10
FORWARD_FIXTURE_COUNT=5
HISTORY_RETENTION_DAYS=730
COLLECT_GAMEWEEK_HISTORY=false
