DATABASE_URL=sqlite:///./data/fpl.db
FPL_ENTRY_ID=

# Access control. demo = market analytics public, personal data and mutations
# require sign-in. private = everything requires sign-in (use for Tailscale/LAN).
# local = no authentication, permitted only with a SQLite database.
ACCESS_MODE=demo
SESSION_SECRET=replace-this-with-a-long-random-value
APP_USERNAME=admin
APP_PASSWORD=replace-this-password
SESSION_MAX_AGE_SECONDS=43200
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=900

CURRENT_SEASON=2026/27
APP_TIMEZONE=America/New_York
REFRESH_HOUR=10
FORWARD_FIXTURE_COUNT=5
HISTORY_RETENTION_DAYS=730
RELIABILITY_SAMPLE_MINUTES=900
ROTATION_SEASON_START_WEIGHT=0.35
ROTATION_SEASON_MINUTES_WEIGHT=0.25
ROTATION_RECENT_START_WEIGHT=0.25
ROTATION_RECENT_MINUTES_WEIGHT=0.15
CSRF_ENABLED=true
COLLECT_GAMEWEEK_HISTORY=false
FORWARD_FORM_WEIGHT=0.40
FORWARD_PPG_WEIGHT=0.35
FORWARD_P90_WEIGHT=0.25
FIXTURE_DIFFICULTY_WEIGHT=0.08
HOME_ADVANTAGE_FACTOR=0.03
